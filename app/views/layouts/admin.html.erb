<!DOCTYPE html>
<html class="h-full">
  <head>
    <title>Admin &mdash; <%= WEDDING[:couple_names] %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Pinyon+Script&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "wedding", "data-turbo-track": "reload" %>
    <%= yield :head %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full">
    <nav class="admin-nav" style="background: var(--color-bg-tertiary); border-bottom: 1px solid var(--color-border-light);" data-controller="nav">
      <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
        <div class="admin-menu-wrapper">
          <button class="nav-hamburger admin-hamburger" data-action="click->nav#toggle" data-nav-target="hamburger" aria-label="Menu">
            <span></span>
            <span></span>
            <span></span>
          </button>
          <div class="admin-nav-links nav-links" data-nav-target="menu">
            <%= link_to "Dashboard", admin_root_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "Invites", admin_invites_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "Guests", admin_guests_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "Children", admin_children_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "Events", admin_events_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "Seating", admin_seating_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "Hotel Bookings", admin_hotel_bookings_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "Emails", admin_emails_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "Notes", admin_notes_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "Import CSV", admin_import_path, class: "type-serif-small", data: { action: "click->nav#close" } %>
            <%= link_to "View Site", root_path, class: "btn btn-ghost btn-sm", data: { action: "click->nav#close" } %>
          </div>
        </div>
        <span class="type-serif-heading" style="font-size: var(--text-lg);">Wedding Admin</span>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 py-8">
      <% if flash[:notice] %>
        <div class="notice"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="notice-error"><%= flash[:alert] %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
