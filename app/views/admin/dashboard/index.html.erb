<div class="flex justify-between items-center mb-6">
  <h1 class="type-serif-heading" style="font-size: var(--text-3xl);">RSVP Dashboard</h1>
  <%= link_to "Download Excel (per event)", admin_guests_xlsx_export_path, class: "btn btn-secondary" %>
</div>

<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
  <%= link_to admin_invites_path, class: "stat-card stat-card-link" do %>
    <p class="stat-label">Invites</p>
    <p class="stat-value"><%= @total_invites %></p>
  <% end %>
  <%= link_to admin_invites_path(status: "responded"), class: "stat-card stat-card-link" do %>
    <p class="stat-label">Responded</p>
    <p class="stat-value"><%= @responded_invites %></p>
  <% end %>
  <%= link_to admin_invites_path(status: "attending"), class: "stat-card stat-card-link" do %>
    <p class="stat-label">Attending</p>
    <p class="stat-value text-success"><%= @attending_invites %></p>
  <% end %>
  <%= link_to admin_invites_path(status: "declined"), class: "stat-card stat-card-link" do %>
    <p class="stat-label">Declined</p>
    <p class="stat-value text-error"><%= @declined_invites %></p>
  <% end %>
  <%= link_to admin_guests_path, class: "stat-card stat-card-link" do %>
    <p class="stat-label">Total Guests</p>
    <p class="stat-value"><%= @total_guests %></p>
  <% end %>
  <%= link_to admin_invites_path(status: "pending"), class: "stat-card stat-card-link" do %>
    <p class="stat-label">Pending</p>
    <p class="stat-value"><%= @pending_invites %></p>
  <% end %>
  <%= link_to admin_guests_path(filter: "children"), class: "stat-card stat-card-link" do %>
    <p class="stat-label">Children</p>
    <p class="stat-value"><%= @children_count %></p>
  <% end %>
  <%= link_to admin_guests_path(filter: "childcare"), class: "stat-card stat-card-link" do %>
    <p class="stat-label">Need Childcare</p>
    <p class="stat-value"><%= @childcare_count %></p>
  <% end %>
</div>

<h2 class="type-serif-heading" style="font-size: var(--text-lg); margin-bottom: var(--space-3);">By Event</h2>
<div class="table-wrapper mb-8">
  <table>
    <thead>
      <tr>
        <th>Event</th>
        <th>Date</th>
        <th class="text-center">Attending</th>
        <th class="text-center">Declined</th>
        <th class="text-center">Pending</th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td><%= link_to event.name, admin_event_path(event) %></td>
          <td class="text-muted"><%= event.date&.strftime("%b %d, %Y") %></td>
          <td class="text-center text-success"><%= link_to event.attending_count, admin_event_path(event, anchor: "attending") %></td>
          <td class="text-center text-error"><%= link_to event.declined_count, admin_event_path(event, anchor: "declined") %></td>
          <td class="text-center text-muted"><%= link_to event.pending_count, admin_event_path(event, anchor: "pending") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @meal_counts.any? %>
  <h2 class="type-serif-heading" style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Meal Choices</h2>
  <div class="card mb-8">
    <div class="flex flex-wrap gap-4">
      <% @meal_counts.each do |choice, count| %>
        <div style="background: var(--color-bg-tertiary); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3);">
          <span style="font-weight: 400; color: var(--color-text-highlight);"><%= choice.titleize %></span>
          <span class="text-muted" style="margin-left: var(--space-1);">(<%= count %>)</span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @recent_notes.any? %>
  <h2 class="type-serif-heading" style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Recent Notes</h2>
  <div class="table-wrapper mb-8">
    <table>
      <thead>
        <tr>
          <th style="width: 30%;">Invite</th>
          <th>Note</th>
        </tr>
      </thead>
      <tbody>
        <% @recent_notes.each do |invite| %>
          <tr>
            <td><%= link_to invite.name, admin_invite_path(invite) %></td>
            <td class="text-muted"><%= invite.notes %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<h2 class="type-serif-heading" style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Recent Ceremony RSVPs</h2>
<div class="table-wrapper mb-8">
  <table>
    <thead>
      <tr>
        <th>Guest</th>
        <th>Invite</th>
        <th>Status</th>
        <th>Responded</th>
      </tr>
    </thead>
    <tbody>
      <% @recent_ceremony_rsvps.each do |rsvp| %>
        <tr>
          <td><%= rsvp.guest.first_name %> <%= rsvp.guest.last_name %></td>
          <td class="text-muted"><%= link_to rsvp.guest.invite.name, admin_invite_path(rsvp.guest.invite) %></td>
          <td>
            <% if rsvp.attending? %>
              <span class="text-success">Attending</span>
            <% elsif rsvp.attending == false %>
              <span class="text-error">Declined</span>
            <% else %>
              <span class="text-muted">Pending</span>
            <% end %>
          </td>
          <td class="text-muted"><%= rsvp.updated_at.strftime("%b %d, %Y %l:%M %p") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
