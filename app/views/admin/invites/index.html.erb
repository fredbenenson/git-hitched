<style>
  .linked-invite-result {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    border-bottom: 1px solid var(--color-border-light);
    padding: var(--space-2);
    cursor: pointer;
    font-family: inherit;
  }
  .linked-invite-result:last-child { border-bottom: none; }
  .linked-invite-result:hover { background: var(--color-bg-tertiary); }
  .linked-invite-result-name { font-size: var(--text-sm); }
  .linked-invite-result-email { font-size: var(--text-xs); color: var(--color-text-muted); }
  .linked-invite-empty { padding: var(--space-2); font-size: var(--text-sm); color: var(--color-text-muted); }
</style>

<div class="flex items-center justify-between mb-6">
  <h1 class="type-serif-heading" style="font-size: var(--text-3xl);">Invites</h1>
  <%= link_to "New Invite", new_admin_invite_path, class: "btn btn-primary btn-sm" %>
</div>

<% if params[:status].present? %>
  <div class="mb-4" style="display: flex; align-items: center; gap: var(--space-2);">
    <span style="background: var(--color-bg-tertiary); border: 1px solid var(--color-border-light); border-radius: var(--radius-sm); padding: var(--space-1) var(--space-3); font-size: var(--text-sm);">
      <%= params[:status].titleize %>
    </span>
    <%= link_to "Clear", admin_invites_path, style: "font-size: var(--text-sm); color: var(--color-text-muted);" %>
  </div>
<% end %>

<%= form_with url: admin_invites_path, method: :get, class: "mb-4" do %>
  <div class="flex gap-2">
    <%= text_field_tag :q, params[:q], placeholder: "Search by name or email...", class: "form-input flex-1" %>
    <%= submit_tag "Search", class: "btn btn-outline btn-sm" %>
  </div>
<% end %>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th style="width: 22%;">Name</th>
        <th class="text-center" style="width: 70px;">Guests</th>
        <th style="width: 100px;">Responded</th>
        <th class="text-center" style="width: 80px;" title="Uncheck to skip from reminders. Already-responded invites are always skipped.">Remind</th>
        <th style="width: 220px;">Linked RSVP</th>
        <th>Notes</th>
      </tr>
    </thead>
    <tbody>
      <% @invites.each do |invite| %>
        <tr>
          <td><%= link_to invite.name, admin_invite_path(invite) %></td>
          <td class="text-center"><%= invite.guests.size %></td>
          <td>
            <% if invite.responded? %>
              <span class="text-success">Yes</span>
            <% else %>
              <span class="text-muted">No</span>
            <% end %>
          </td>
          <%= render "reminder_cell", invite: invite %>
          <%= render "link_cell", invite: invite %>
          <td class="text-muted" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= truncate(invite.notes, length: 50) if invite.notes.present? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
